<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_files.xml -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:id="@+id/filesHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="@color/bg_toolbar">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Files"
            android:fontFamily="serif"
            android:textSize="24sp"
            android:textColor="@color/text_on_brown"/>

        <Button
            android:id="@+id/btnSelectMode"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select"
            android:textColor="@color/text_on_brown"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFiles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/filesHeader"
        android:padding="12dp"
        android:clipToPadding="false"/>

    <TextView
        android:id="@+id/emptyFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="No exported files yet.\nExport a note to see it here."
        android:gravity="center"
        android:textColor="@color/text_tertiary"
        android:padding="40dp"
        android:visibility="gone"/>

    <!-- Batch Action Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/batchActionBar"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        app:cardCornerRadius="28dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardElevation="10dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/tvSelectionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 selected"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="24dp"/>

            <ImageButton
                android:id="@+id/btnBatchDelete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#C0392B"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
