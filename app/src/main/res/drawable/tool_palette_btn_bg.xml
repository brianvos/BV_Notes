<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected / Active (Recessed look) -->
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@color/neu_sidebar_shadow" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp">
                <shape>
                    <solid android:color="@color/folder_row_selected" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default (Raised look) -->
    <item>
        <layer-list>
            <!-- Dark shadow -->
            <item android:left="2dp" android:top="2dp">
                <shape>
                    <solid android:color="@color/neu_sidebar_shadow" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- Light highlight -->
            <item android:right="2dp" android:bottom="2dp">
                <shape>
                    <solid android:color="@color/neu_sidebar_highlight" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- Surface -->
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape>
                    <solid android:color="@color/bg_sidebar" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>