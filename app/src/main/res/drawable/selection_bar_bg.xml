<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark shadow -->
    <item android:left="3dp" android:top="3dp" android:right="0dp" android:bottom="0dp">
        <shape>
            <solid android:color="@color/neu_primary_shadow" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Light highlight -->
    <item android:left="0dp" android:top="0dp" android:right="3dp" android:bottom="3dp">
        <shape>
            <solid android:color="@color/neu_primary_highlight" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Surface -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <solid android:color="@color/bg_card" />
            <stroke android:width="1dp" android:color="@color/divider" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>